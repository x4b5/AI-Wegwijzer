    <script>
      function searchBegrippen() {
        const searchInput = document.getElementById('searchInput');
        const searchResults = document.getElementById('searchResults');
        const stickySearchResults = document.getElementById('stickySearchResults');
        const searchTerm = searchInput.value.toLowerCase().trim();
        
        // Verzamel alle begrippen blokken
        const begrippenBlokken = document.querySelectorAll('.content-block.trivia[id]');
        let visibleCount = 0;
        let totalCount = begrippenBlokken.length;
        
        begrippenBlokken.forEach(blok => {
          const begripId = blok.id;
          const begripTitel = blok.querySelector('.trivia-toggle strong')?.textContent || '';
          const begripInhoud = blok.textContent || '';
          const verborgenInhoud = blok.querySelector('.trivia-content')?.textContent || '';
          
          // Zoek in ID, titel en inhoud (inclusief verborgen content)
          const matchesId = begripId.toLowerCase().includes(searchTerm);
          const matchesTitel = begripTitel.toLowerCase().includes(searchTerm);
          const matchesInhoud = begripInhoud.toLowerCase().includes(searchTerm);
          const matchesVerborgen = verborgenInhoud.toLowerCase().includes(searchTerm);
          
          if (searchTerm === '' || matchesId || matchesTitel || matchesInhoud || matchesVerborgen) {
            blok.classList.remove('hidden');
            blok.classList.add('visible');
            visibleCount++;
          } else {
            blok.classList.remove('visible');
            blok.classList.add('hidden');
          }
        });
        
        // Update beide zoekresultaten tellers
        if (searchTerm === '') {
          searchResults.textContent = '';
          stickySearchResults.style.display = 'none';
        } else {
          const resultText = `${visibleCount} van ${totalCount} begrippen gevonden`;
          searchResults.textContent = resultText;
          stickySearchResults.textContent = resultText;
          stickySearchResults.style.display = 'block';
        }
      }
      
      // Niveau mapping
      const categoryMapping = {
        'basis': ['artificiele-intelligentie', 'ai-model', 'chatbot', 'chatgpt', 'prompt', 'user-interface', 'machine-learning', 'ai-geletterdheid', 'ai-boom', 'ai-effect'],
        'gemiddeld': ['ai-agent', 'ai-assistent', 'ai-bias', 'generatieve-ai', 'discriminatieve-ai', 'deep-learning', 'neuraal-netwerk', 'rag', 'prompt-engineering', 'data-gedreven', 'regelgebaseerd', 'gpt', 'llm', 'foundation-model'],
        'gevorderd': ['agi', 'ai-productiviteitsparadox', 'transformer-architectuur', 'deterministisch', 'probabilistisch', 'immersive-interfaces', 'virtual-reality', 'augmented-reality', 'mixed-reality', 'brain-computer-interface', 'conversational-user-interface', 'openai', 'claude', 'mistral', 'gemini', 'multi-model-platform', 'open-source-models']
      };

      // A-Z index genereren
      function generateAZIndex() {
        const azButtons = document.getElementById('azButtons');
        const begrippenBlokken = document.querySelectorAll('.content-block.trivia[id]');
        const firstLetters = new Set();
        
        begrippenBlokken.forEach(blok => {
          const firstLetter = blok.id.charAt(0).toUpperCase();
          firstLetters.add(firstLetter);
        });
        
        const sortedLetters = Array.from(firstLetters).sort();
        
        sortedLetters.forEach(letter => {
          const button = document.createElement('button');
          button.textContent = letter;
          button.style.cssText = `
            padding: 8px 12px;
            border: 2px solid var(--gray-300);
            background: var(--white);
            color: var(--text-primary);
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: bold;
            transition: all 0.3s ease;
            min-width: 40px;
          `;
          
          button.addEventListener('click', () => scrollToLetter(letter));
          button.addEventListener('mouseenter', () => {
            button.style.borderColor = 'var(--primary-blue)';
            button.style.backgroundColor = 'var(--primary-blue)';
            button.style.color = 'white';
          });
          button.addEventListener('mouseleave', () => {
            if (!button.classList.contains('active')) {
              button.style.borderColor = 'var(--gray-300)';
              button.style.backgroundColor = 'var(--white)';
              button.style.color = 'var(--text-primary)';
            }
          });
          
          azButtons.appendChild(button);
        });
      }

      // Scroll naar letter
      function scrollToLetter(letter) {
        const begrippenBlokken = document.querySelectorAll('.content-block.trivia[id]');
        const targetBlok = Array.from(begrippenBlokken).find(blok => 
          blok.id.charAt(0).toUpperCase() === letter
        );
        
        if (targetBlok) {
          targetBlok.scrollIntoView({ behavior: 'smooth', block: 'start' });
          
          // Highlight de knop
          document.querySelectorAll('#azButtons button').forEach(btn => {
            btn.classList.remove('active');
            btn.style.borderColor = 'var(--gray-300)';
            btn.style.backgroundColor = 'var(--white)';
            btn.style.color = 'var(--text-primary)';
          });
          
          const activeButton = Array.from(document.querySelectorAll('#azButtons button')).find(btn => 
            btn.textContent === letter
          );
          if (activeButton) {
            activeButton.classList.add('active');
            activeButton.style.borderColor = 'var(--primary-blue)';
            activeButton.style.backgroundColor = 'var(--primary-blue)';
            activeButton.style.color = 'white';
          }
        }
      }

      // Niveau filtering
      function filterByCategory(category) {
        const begrippenBlokken = document.querySelectorAll('.content-block.trivia[id]');
        const searchInput = document.getElementById('searchInput');
        
        // Reset zoekbalk
        searchInput.value = '';
        
        begrippenBlokken.forEach(blok => {
          const begripId = blok.id;
          let shouldShow = false;
          
          if (category === 'all') {
            shouldShow = true;
          } else {
            const categoryBegrippen = categoryMapping[category] || [];
            shouldShow = categoryBegrippen.includes(begripId);
          }
          
          if (shouldShow) {
            blok.classList.remove('hidden');
            blok.classList.add('visible');
          } else {
            blok.classList.remove('visible');
            blok.classList.add('hidden');
          }
        });
        
        // Update tellers
        const visibleCount = document.querySelectorAll('.content-block.trivia.visible').length;
        const totalCount = begrippenBlokken.length;
        const resultText = category === 'all' ? '' : `${visibleCount} begrippen op niveau "${category}"`;
        
        document.getElementById('searchResults').textContent = resultText;
        document.getElementById('stickySearchResults').textContent = resultText;
        document.getElementById('stickySearchResults').style.display = resultText ? 'block' : 'none';
      }

      // Focus op zoekbalk bij laden van pagina
      document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchInput');
        if (searchInput) {
          searchInput.focus();
        }
        
        // Genereer A-Z index
        generateAZIndex();
        
        // Voeg event listeners toe voor niveau knoppen
        document.querySelectorAll('.category-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            // Update actieve knop
            document.querySelectorAll('.category-btn').forEach(b => {
              b.classList.remove('active');
              b.style.borderColor = 'var(--gray-300)';
              b.style.backgroundColor = 'var(--white)';
              b.style.color = 'var(--text-primary)';
            });
            
            btn.classList.add('active');
            btn.style.borderColor = 'var(--primary-blue)';
            btn.style.backgroundColor = 'var(--primary-blue)';
            btn.style.color = 'white';
            
            // Filter begrippen
            const category = btn.getAttribute('data-category');
            filterByCategory(category);
          });
        });
      });
    </script>

    <script>
    function toggleTrivia(element) {
        const content = element.nextElementSibling;
        const icon = element.querySelector('.trivia-toggle-icon');
        
        if (content.classList.contains('expanded')) {
            content.classList.remove('expanded');
            icon.classList.remove('expanded');
        } else {
            content.classList.add('expanded');
            icon.classList.add('expanded');
        }
    }
    </script>
